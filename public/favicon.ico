```typescript
// app/layout.tsx

import { Inter } from 'next/font/google';
import Head from 'next/head';
import { FC, ReactNode } from 'react';

const inter = Inter({ subsets: ['latin'] });

interface LayoutProps {
  children?: ReactNode;
}

const Layout: FC<LayoutProps> = ({ children }) => (
  <>
    <Head>
      <meta charSet="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Your App Title</title>
      <link rel="icon" href="/favicon.ico" />
      <meta
        name="description"
        content="A brief description of your app."
      />
      <meta property="og:title" content="Your App Title" />
      <meta property="og:description" content="A brief description of your app." />
      <meta property="og:url" content="https://yourapp.com" />
      <meta property="og:image" content="/path/to/your/image.jpg" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="Your App Title" />
      <meta name="twitter:description" content="A brief description of your app." />
      <meta name="twitter:image" content="/path/to/your/image.jpg" />
    </Head>
    <div className={inter.className}>
      {children}
    </div>
  </>
);

export default Layout;
```

