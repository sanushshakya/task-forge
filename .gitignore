# .gitignore
# Ignore all files and folders
*
# Except these:
!.gitignore
!package.json
!README.md

# Node.js specific
node_modules/
package-lock.json

# OS generated
.DS_Store
Thumbs.db

# IDEs and editors
.idea/
.vscode/

# Logs
*.log

# NPM specific
npm-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/
public/build/

# Ignore API routes folder
app/api/