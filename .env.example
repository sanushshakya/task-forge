# .env.example

# MongoDB connection string
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/database?retryWrites=true&w=majority"

# JWT secret for token signing and verification
JWT_SECRET_KEY="your-256-bit-secret"

# Port number for the application to listen on
PORT=3000

# Domain name or IP address for Vercel deployment
DOMAIN_NAME="https://yourdomain.com"

# Email server configuration for sending emails
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USERNAME="your-email@example.com"
EMAIL_PASSWORD="your-email-password"

# Redis cache configuration for caching data
REDIS_URL="redis://localhost:6379/0"

# Ollama API endpoint and authentication token
OLLAMA_API_URL="https://api.ollama.com/v1"
OLLAMA_API_TOKEN="your-ollama-api-token"

# Feature flags (if any)
FEATURE_FLAG_AI_SUMMARIES=true
FEATURE_FLAG_WEEKLY_INSIGHTS=false